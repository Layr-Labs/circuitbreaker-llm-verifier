{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "circuitbreaker-expression-v2"
    },
    "convention": {
      "const": "uniform-np-full-b2-actual-length-all-lengths-v1"
    },
    "family": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "theorem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "guarantee": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "polynomial_log"
            },
            "coefficient": {
              "$ref": "#/$defs/rational"
            },
            "exponent": {
              "$ref": "#/$defs/rational"
            },
            "log_exponent": {
              "$ref": "#/$defs/rational"
            },
            "loglog_exponent": {
              "$ref": "#/$defs/rational"
            }
          },
          "required": [
            "kind",
            "coefficient",
            "exponent",
            "log_exponent",
            "loglog_exponent"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "lane_endpoint"
            },
            "exponent": {
              "$ref": "#/$defs/rational"
            }
          },
          "required": [
            "kind",
            "exponent"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "superpolynomial"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "eventual_lower_bound"
            },
            "leading": {
              "$ref": "#/$defs/polynomial_log"
            },
            "remainder": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "explicit"
                    },
                    "terms": {
                      "type": "array",
                      "minItems": 0,
                      "maxItems": 8,
                      "items": {
                        "$ref": "#/$defs/monomial"
                      }
                    }
                  },
                  "required": [
                    "kind",
                    "terms"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "exponent": {
                      "$ref": "#/$defs/rational"
                    },
                    "log_exponent": {
                      "$ref": "#/$defs/rational"
                    },
                    "loglog_exponent": {
                      "$ref": "#/$defs/rational"
                    },
                    "kind": {
                      "const": "big_o"
                    }
                  },
                  "required": [
                    "kind",
                    "exponent",
                    "log_exponent",
                    "loglog_exponent"
                  ]
                }
              ]
            }
          },
          "required": [
            "kind",
            "leading",
            "remainder"
          ]
        }
      ]
    },
    "projection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "finite"
            },
            "coefficient": {
              "$ref": "#/$defs/rational"
            },
            "exponent": {
              "$ref": "#/$defs/rational"
            }
          },
          "required": [
            "kind",
            "coefficient",
            "exponent"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "lane_endpoint"
            },
            "exponent": {
              "$ref": "#/$defs/rational"
            }
          },
          "required": [
            "kind",
            "exponent"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "global_endpoint"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    }
  },
  "required": [
    "version",
    "convention",
    "family",
    "theorem",
    "guarantee",
    "projection"
  ],
  "$defs": {
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "string",
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "maxLength": 256
        },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 256
        }
      },
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "polynomial_log": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "polynomial_log"
        },
        "coefficient": {
          "$ref": "#/$defs/rational"
        },
        "exponent": {
          "$ref": "#/$defs/rational"
        },
        "log_exponent": {
          "$ref": "#/$defs/rational"
        },
        "loglog_exponent": {
          "$ref": "#/$defs/rational"
        }
      },
      "required": [
        "kind",
        "coefficient",
        "exponent",
        "log_exponent",
        "loglog_exponent"
      ]
    },
    "monomial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coefficient": {
          "$ref": "#/$defs/rational"
        },
        "exponent": {
          "$ref": "#/$defs/rational"
        },
        "log_exponent": {
          "$ref": "#/$defs/rational"
        },
        "loglog_exponent": {
          "$ref": "#/$defs/rational"
        }
      },
      "required": [
        "coefficient",
        "exponent",
        "log_exponent",
        "loglog_exponent"
      ]
    }
  },
  "$comment": "Runtime additionally checks reduced bounded rationals, positive leading/remainder coefficients, leading p>=1, projection implication, and lexicographic remainder powers >=(0,0,0) and strictly below leading powers. Explicit terms must be strictly descending with no duplicate powers; never normalize duplicates or infer remainders from a liminf. This schema validates shape, not a proof."
}

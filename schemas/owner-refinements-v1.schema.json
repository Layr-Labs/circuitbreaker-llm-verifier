{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "circuitbreaker-owner-refinements-v1"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
          },
          "origin": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "benchmarkId": {
                "$ref": "#/$defs/identity"
              },
              "submissionId": {
                "$ref": "#/$defs/identity"
              },
              "packetId": {
                "$ref": "#/$defs/identity"
              },
              "candidateKey": {
                "$ref": "#/$defs/identity"
              },
              "evaluationId": {
                "$ref": "#/$defs/identity"
              },
              "validityVersionId": {
                "$ref": "#/$defs/identity"
              },
              "originalEnvelopeSha256": {
                "$ref": "#/$defs/hash"
              },
              "originalRichSha256": {
                "$ref": "#/$defs/hash"
              },
              "intakeSha256": {
                "$ref": "#/$defs/hash"
              },
              "dossierSha256": {
                "$ref": "#/$defs/hash"
              },
              "sourceSha256": {
                "$ref": "#/$defs/hash"
              },
              "scoreEvidence": {
                "$ref": "#/$defs/evidence"
              },
              "validityEvidence": {
                "$ref": "#/$defs/evidence"
              }
            },
            "required": [
              "benchmarkId",
              "submissionId",
              "packetId",
              "candidateKey",
              "evaluationId",
              "validityVersionId",
              "originalEnvelopeSha256",
              "originalRichSha256",
              "intakeSha256",
              "dossierSha256",
              "sourceSha256",
              "scoreEvidence",
              "validityEvidence"
            ]
          },
          "targetBound": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "version": {
                "const": "circuitbreaker-expression-v2"
              },
              "convention": {
                "const": "uniform-np-full-b2-actual-length-all-lengths-v1"
              },
              "family": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "theorem": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "guarantee": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "eventual_lower_bound"
                  },
                  "leading": {
                    "$ref": "#/$defs/polynomial_log"
                  },
                  "remainder": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "const": "explicit"
                          },
                          "terms": {
                            "type": "array",
                            "minItems": 0,
                            "maxItems": 8,
                            "items": {
                              "$ref": "#/$defs/monomial"
                            }
                          }
                        },
                        "required": [
                          "kind",
                          "terms"
                        ]
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "exponent": {
                            "$ref": "#/$defs/rational"
                          },
                          "log_exponent": {
                            "$ref": "#/$defs/rational"
                          },
                          "loglog_exponent": {
                            "$ref": "#/$defs/rational"
                          },
                          "kind": {
                            "const": "big_o"
                          }
                        },
                        "required": [
                          "kind",
                          "exponent",
                          "log_exponent",
                          "loglog_exponent"
                        ]
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "leading",
                  "remainder"
                ]
              },
              "projection": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "finite"
                  },
                  "coefficient": {
                    "$ref": "#/$defs/rational"
                  },
                  "exponent": {
                    "$ref": "#/$defs/rational"
                  }
                },
                "required": [
                  "kind",
                  "coefficient",
                  "exponent"
                ]
              }
            },
            "required": [
              "version",
              "convention",
              "family",
              "theorem",
              "guarantee",
              "projection"
            ]
          },
          "audit": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "manifestSha256": {
                "$ref": "#/$defs/hash"
              },
              "receiptSha256": {
                "$ref": "#/$defs/hash"
              }
            },
            "required": [
              "manifestSha256",
              "receiptSha256"
            ]
          },
          "recordSha256": {
            "$ref": "#/$defs/hash"
          }
        },
        "required": [
          "id",
          "origin",
          "targetBound",
          "audit",
          "recordSha256"
        ]
      }
    }
  },
  "required": [
    "version",
    "records"
  ],
  "$defs": {
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "string",
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "maxLength": 256
        },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 256
        }
      },
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "polynomial_log": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "polynomial_log"
        },
        "coefficient": {
          "$ref": "#/$defs/rational"
        },
        "exponent": {
          "$ref": "#/$defs/rational"
        },
        "log_exponent": {
          "$ref": "#/$defs/rational"
        },
        "loglog_exponent": {
          "$ref": "#/$defs/rational"
        }
      },
      "required": [
        "kind",
        "coefficient",
        "exponent",
        "log_exponent",
        "loglog_exponent"
      ]
    },
    "monomial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coefficient": {
          "$ref": "#/$defs/rational"
        },
        "exponent": {
          "$ref": "#/$defs/rational"
        },
        "log_exponent": {
          "$ref": "#/$defs/rational"
        },
        "loglog_exponent": {
          "$ref": "#/$defs/rational"
        }
      },
      "required": [
        "coefficient",
        "exponent",
        "log_exponent",
        "loglog_exponent"
      ]
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resultId": {
          "$ref": "#/$defs/identity"
        },
        "evaluatorId": {
          "$ref": "#/$defs/identity"
        },
        "policyVersionId": {
          "$ref": "#/$defs/identity"
        },
        "sourceRef": {
          "$ref": "#/$defs/identity"
        },
        "jobId": {
          "$ref": "#/$defs/identity"
        },
        "commitSha": {
          "$ref": "#/$defs/identity"
        },
        "evaluatedAt": {
          "$ref": "#/$defs/identity"
        }
      },
      "required": [
        "resultId",
        "evaluatorId",
        "policyVersionId",
        "sourceRef",
        "jobId",
        "commitSha",
        "evaluatedAt"
      ]
    }
  },
  "$comment": "Structural shape only. Runtime must enforce unique IDs/origins, canonical rationals, origin/target bindings, digest recomputation and current admission/review/access gates. Owner page revision supplies authority, never a self-approved flag."
}

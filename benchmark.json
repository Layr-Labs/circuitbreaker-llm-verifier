{
  "schemaVersion": 2,
  "name": "circuitbreaker",
  "tracks": [
    {
      "name": "main",
      "description": "circuitbreaker",
      "category": "math",
      "mode": "pareto",
      "promotionMode": "manual",
      "direction": "+",
      "objectives": [
        {
          "name": "gate_coefficient",
          "direction": "+"
        },
        {
          "name": "gate_exponent",
          "direction": "+"
        }
      ],
      "paretoPolicies": {
        "scoring": {
          "version": "coefficient-exponent-expression-v1"
        },
        "validity": {
          "version": "fixed-family-full-b2-v1"
        }
      },
      "editablePaths": [
        "submission"
      ],
      "submissionAdmission": {
        "version": 1,
        "submissionReferencesEnabled": false
      },
      "setupCommand": [
        "llm-verifier",
        "intake",
        "--root",
        ".",
        "--out",
        ".yukon/work/intake.json"
      ],
      "benchmarkCommand": [
        "python3",
        "finalize_score.py",
        "--intake",
        ".yukon/work/intake.json",
        "--initial",
        ".yukon/work/initial.json",
        "--initial-review",
        ".yukon/work/review.json",
        "--score",
        ".yukon/score.json",
        "--dossier",
        ".yukon/dossier.json"
      ],
      "scorePath": ".yukon/score.json",
      "maxSubmissionBytes": 262144,
      "runner": {
        "provider": "github-actions",
        "workflow": "benchmark.yml",
        "scoreArtifactName": "circuitbreaker-score",
        "maxConcurrentWorkflows": 2
      }
    }
  ]
}
